# Copy to .env for local use. On Vercel set these under Project > Settings > Environment Variables.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/masms?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# Optional
# Where the first school's data is stored (other schools use tenant:<code>). Leave as is.
SNAPSHOT_KEY=default
# Sign-in attempts allowed per IP every 15 minutes (default 20)
AUTH_RATE_LIMIT=20
# "Forgot password" code requests allowed per IP every 15 minutes (default 10). Needs SMS and/or email set up below.
RECOVER_RATE_LIMIT=10
CORS_ORIGIN=

# --- Communication & payments (all optional; each feature shows 'not set up' until its variables exist) ---
# SMS via Africa's Talking (use AT_USERNAME=sandbox for testing)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Email via any SMTP server (Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School Name <office@school.ac.ke>"
# M-Pesa Daraja STK push. PUBLIC_URL = your deployed https address; MPESA_CALLBACK_SECRET = long random string
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL=
MPESA_CALLBACK_SECRET=
PUBLIC_URL=

# Automatic app updates (Android). Update these after publishing a new build; see README "Automatic updates".
APP_LATEST_VERSION_CODE=
APP_LATEST_VERSION_NAME=
APP_MIN_VERSION_CODE=
APP_DOWNLOAD_URL=
APP_UPDATE_NOTES=

# WhatsApp codes for forgot password (Meta WhatsApp Business Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=

# Claude AI marking of structured (written) online exam answers: marks by meaning, accepts different wording, credits implied steps.
# Without a key the built-in word-matching marker is used.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
