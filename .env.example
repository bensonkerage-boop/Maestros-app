# Copy to .env for local use. On Vercel set these under Project > Settings > Environment Variables.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/masms?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# Optional
SNAPSHOT_KEY=default
CORS_ORIGIN=

# --- Communication & payments (all optional; each feature shows 'not set up' until its variables exist) ---
# SMS via Africa's Talking (use AT_USERNAME=sandbox for testing)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Email via any SMTP server (Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="School Name <office@school.ac.ke>"
# M-Pesa Daraja STK push. PUBLIC_URL = your deployed https address; MPESA_CALLBACK_SECRET = long random string
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL=
MPESA_CALLBACK_SECRET=
PUBLIC_URL=
